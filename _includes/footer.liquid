<footer class="site-footer" role="contentinfo">
  <div class="container site-footer-content">
    <span
      >Last Updated: <time datetime="{{ site.time | date: '%Y-%m-%d' }}">{{ site.time | date: '%B %d, %Y' }}</time></span
    >
    <span class="site-footer-copyright"
      >&copy; {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name -}}
    </span>
  </div>
</footer>
